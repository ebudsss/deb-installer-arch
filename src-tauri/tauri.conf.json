{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DebInstaller",
  "version": "0.1.0",
  "identifier": "io.github.debinstaller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DebInstaller",
        "width": 1000,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Pasang paket .deb di Arch Linux",
    "longDescription": "Mengonversi paket .deb menjadi paket pacman native, memetakan dependensi Debian ke Arch, dan menampilkan script maintainer sebelum dipasang.",
    "linux": {
      "deb": {
        "depends": ["webkit2gtk-4.1", "gtk3", "polkit"]
      }
    }
  }
}
