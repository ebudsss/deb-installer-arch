# Maintainer: ebudsss <ebudsss@users.noreply.github.com>
pkgname=deb-installer
pkgver=0.1.0
pkgrel=1
pkgdesc="GUI installer that converts .deb packages into native pacman packages"
arch=('x86_64')
url="https://github.com/ebudsss/deb-installer-arch"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'polkit' 'pacman' 'zstd' 'xz' 'gzip' 'curl')
makedepends=('cargo' 'nodejs' 'pnpm' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"

  # Frontend: build statis ke dist/, lalu dibundel oleh tauri.
  pnpm install --frozen-lockfile
  pnpm build

  # Backend: Tauri membangun binari rilis dengan aset frontend tertanam.
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p deb-installer
}

check() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked -p deb-installer-core
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/deb-installer" \
    "$pkgdir/usr/bin/deb-installer"
  install -Dm644 packaging/deb-installer.desktop \
    "$pkgdir/usr/share/applications/deb-installer.desktop"
  install -Dm644 packaging/deb-installer-mime.xml \
    "$pkgdir/usr/share/mime/packages/deb-installer.xml"
  for size in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512; do
    install -Dm644 "src-tauri/icons/$size.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/deb-installer.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
